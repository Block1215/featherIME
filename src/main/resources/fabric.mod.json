{
	"schemaVersion": 1,
	"id": "featherime",
	"version": "${version}",
	"name": "FeatherIME",
	"description": "Feather Client compatible IME improvement mod for Minecraft. Based on caramelChat (LGPL-3.0-or-later) and CocoaInput-lib (MMPL_J-1.0.1). See CREDITS.md.",
	"authors": [ "@Bl" ],
	"contributors": [ "LemonCaramel (caramelChat, upstream)", "Korea-Minecraft-Forum (CocoaInput-lib, upstream)", "Axeryok (CocoaInput, upstream)" ],
	"license": "LGPL-3.0-or-later AND LicenseRef-MMPL-J-1.0.1",
	"contact": {
		"homepage": "https://modrinth.com/mod/featherime",
		"sources": "https://github.com/Block1215/featherIME"
	},
	"icon": "assets/featherIME/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [ "dev.bl.feathercaramel.FeatherCaramelChatClient" ]
	},
	"accessWidener": "featherIME.accesswidener",
	"mixins": [
		{ "config": "featherIME.mixins.json", "environment": "client" }
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "~1.20.6",
		"java": ">=21",
		"fabric-api": "*"
	}
}
